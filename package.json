{
  "name": "bergeron-maps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config vitest.db.config.ts",
    "build:site": "python3 site/build-drawings.py && vite-node scripts/site-demo.ts && tailwindcss -i site/src/input.css -o site/styles.css --minify"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/overpass": "^5.1.1",
    "@supabase/supabase-js": "^2.118.0",
    "immer": "10.1.1",
    "konva": "9.3.18",
    "nanoid": "5.1.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-konva": "18.2.10",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.1.11",
    "@testing-library/react": "16.0.1",
    "@types/pg": "^8.11.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "fake-indexeddb": "6.0.0",
    "jsdom": "25.0.1",
    "pg": "^8.13.1",
    "tailwindcss": "^4.1.11",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
